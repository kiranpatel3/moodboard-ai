# Copy this file to .env and fill in your values.

PORT=5000

# Allowed browser origin for CORS (required in production)
FRONTEND_URL=http://localhost:5173

# Anthropic Claude (required for /api/generate-relation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini (optional, installed for future use)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
